  "cards": [
    {
      "dot": "cyan",
      "title": "Zugang",
      "items": [
        "Nur Nginx Proxy Manager ist öffentlich erreichbar",
        "Alle Aufrufe aus dem Browser (SPA, REST, Login) laufen über ihn",
        "Weiterleitung per Subdomain an den jeweiligen Container"
      ]
    },
    {
      "dot": "violet",
      "title": "Orchestrierung",
      "items": [
        "CIB seven führt die BPMN-Prozesse aus und steuert die Services",
        "SPA: Fachdaten (z. B. Liste von Entitäten) vom Microservice, Prozessinteraktion (z. B. offene Tasks) direkt bei CIB seven",
        "Microservices starten Prozessinstanzen, arbeiten Tasks ab, lesen und schreiben Variablen",
        "Jeder Microservice hat seine eigene Datenbank; A und B stehen exemplarisch für beliebig viele"
      ]
    },
    {
      "dot": "rose",
      "title": "Sicherheit",
      "items": [
        "Login über Keycloak (OpenID Connect)",
        "SPA schickt das JWT als Bearer-Token mit",
        "Microservices und CIB seven validieren Tokens gegen Keycloak"
      ]
    }
  ]
